# Copy to .env (the setup does this) and fill in what you use. .env is never committed.

# Application tracker in Google Sheets (read-only). The ID is the long string in the sheet URL.
JOBPIPE_SHEET_ID=
# Service-account JSON for the sheet. Share the sheet with its email as Viewer.
GOOGLE_APPLICATION_CREDENTIALS=secrets/jobpipe-sheet.service-account.json

# API keys, only for the providers you use.
# Free key from https://aistudio.google.com/apikey (Gemini CLI):
GEMINI_API_KEY=
# Anthropic API, pay per use:
ANTHROPIC_API_KEY=
# OpenAI or another OpenAI-compatible API:
OPENAI_API_KEY=
